{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimhw8084/agent-skills/blob/main/k-slide/schemas/evidence-ir.schema.json",
  "title": "K-Slide Engine EvidenceIR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_revision", "document_id", "work_unit_id", "source", "regions", "tables", "numeric_facts", "visual_elements", "native_evidence", "required_source_ids"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "document_id": {"type": "string"},
    "work_unit_id": {"type": "string"},
    "source": {"type": "object", "required": ["document_id", "context_image_path", "context_image_sha256"]},
    "regions": {"type": "array", "items": {"type": "object", "required": ["region_id", "bbox_px", "bbox_normalized", "reading_order", "region_type", "required_for_translation"], "properties": {"region_id": {"type": "string"}, "bbox_px": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}, "bbox_normalized": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}, "reading_order": {"type": "integer"}, "region_type": {"type": "string"}, "language": {"enum": ["ko", "en", "mixed", "unknown", null]}, "source_english_spans": {"type": "array", "items": {"type": "string", "minLength": 1}}, "required_for_translation": {"type": "boolean"}}}},
    "tables": {"type": "array", "items": {"type": "object", "required": ["table_id", "row_count", "column_count", "cells"], "properties": {"table_id": {"type": "string"}, "row_count": {"type": "integer", "minimum": 1}, "column_count": {"type": "integer", "minimum": 1}, "headers": {"type": "array", "items": {"type": "string"}}, "header_rows": {"type": "array", "items": {"type": "integer", "minimum": 0}}, "header_columns": {"type": "array", "items": {"type": "integer", "minimum": 0}}, "unit": {"type": ["string", "null"]}, "source_notes": {"type": "array", "items": {"type": "string"}}, "cells": {"type": "array", "items": {"type": "object", "required": ["cell_id", "row", "column", "rowspan", "colspan"], "properties": {"cell_id": {"type": "string"}, "row": {"type": "integer", "minimum": 0}, "column": {"type": "integer", "minimum": 0}, "rowspan": {"type": "integer", "minimum": 1}, "colspan": {"type": "integer", "minimum": 1}, "source_text": {"type": ["string", "null"]}, "source_language": {"enum": ["ko", "en", "mixed", "unknown", null]}, "source_english_spans": {"type": "array", "items": {"type": "string", "minLength": 1}}, "cell_state": {"enum": ["nonblank", "blank", "merge_origin", "merge_continuation", "unknown"]}, "is_merge_origin": {"type": ["boolean", "null"]}, "is_spanned": {"type": ["boolean", "null"]}, "is_blank": {"type": ["boolean", "null"]}, "is_header": {"type": ["boolean", "null"]}}}}}}},
    "numeric_facts": {"type": "array", "items": {"type": "object", "required": ["fact_id", "source_string"], "properties": {"fact_id": {"type": "string"}, "source_string": {"type": "string"}, "source_object_id": {"type": ["string", "null"]}, "source_region_id": {"type": ["string", "null"]}, "source_table_id": {"type": ["string", "null"]}, "source_cell_id": {"type": ["string", "null"]}}}},
    "visual_elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["element_id", "kind", "required"],
        "properties": {
          "element_id": {"type": "string"},
          "kind": {"type": "string"},
          "bbox_px": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
          "required": {"type": "boolean"},
          "path": {"type": "string"},
          "sha256": {"type": "string"},
          "chart": {"type": "object"},
          "connector": {
            "type": "object",
            "properties": {
              "from_element_id": {"type": "string"},
              "to_element_id": {"type": "string"},
              "start_arrow_type": {"type": "string"},
              "end_arrow_type": {"type": "string"},
              "direction_evidence": {"enum": ["start_to_end", "end_to_start", "bidirectional", "undirected", "ambiguous"]},
              "direction_evidence_source": {"type": "string"}
            }
          }
        }
      }
    },
    "native_evidence": {"type": "array"},
    "required_source_ids": {"type": "array", "items": {"type": "string"}}
  }
}
