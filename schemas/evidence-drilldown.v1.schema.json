{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k-slide.local/schemas/evidence-drilldown.v1.schema.json",
  "title": "K-Slide Evidence Drill-down Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "canonical_state_sha256", "sources", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "canonical_state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "work_unit_id", "source_index", "source_name", "evidence_ir_path", "translation_ir_path", "evidence_ids", "crop_paths", "decision_item_ids"],
        "properties": {
          "document_id": {"type": "string"},
          "work_unit_id": {"type": "string"},
          "source_index": {"type": "integer", "minimum": 0},
          "source_name": {"type": "string"},
          "evidence_ir_path": {"type": ["string", "null"]},
          "translation_ir_path": {"type": ["string", "null"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "crop_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "decision_item_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "canonical_ref", "evidence_ids", "source_refs"],
        "properties": {
          "item_id": {"type": "string"},
          "canonical_ref": {"type": "object"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "source_refs": {"type": "array", "items": {"type": "object"}}
        }
      }
    }
  }
}
