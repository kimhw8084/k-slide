{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimhw8084/agent-skills/blob/main/k-slide/schemas/translation-patch.schema.json",
  "title": "K-Slide Gemma TranslationPatch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_unit_id", "evidence_revision", "regions", "tables", "visual_interpretations", "executive_claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "work_unit_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "evidence_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repair_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "regions": {"type": "array", "items": {"$ref": "#/$defs/region"}},
    "tables": {"type": "array", "items": {"$ref": "#/$defs/table"}},
    "visual_interpretations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "executive_claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
  },
  "$defs": {
    "commitment": {"enum": ["decided", "committed", "planned", "scheduled", "target", "proposed", "under_review", "needs_review", "discussion_required", "expected", "forecast", "possible", "tentative", "not_decided", "completed", "in_progress", "unknown"]},
    "speech": {"enum": ["fact", "status", "decision", "plan", "request", "recommendation", "risk", "dependency", "forecast", "question", "unknown"]},
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "english", "term_ids", "unresolved"],
      "properties": {
        "region_id": {"type": "string"},
        "english": {"type": "string"},
        "commitment_status": {"$ref": "#/$defs/commitment"},
        "speech_act": {"$ref": "#/$defs/speech"},
        "term_ids": {"type": "array", "items": {"type": "string"}},
        "unresolved": {"type": "boolean"},
        "unresolved_reason": {"type": "string"},
        "hangul_retention": {"$ref": "#/$defs/hangul_retention"}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table_id", "cells"],
      "properties": {"table_id": {"type": "string"}, "cells": {"type": "array", "items": {"$ref": "#/$defs/cell"}}}
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id", "english", "unresolved"],
      "properties": {
        "cell_id": {"type": "string"},
        "english": {"type": "string"},
        "unresolved": {"type": "boolean"},
        "unresolved_reason": {"type": "string"},
        "hangul_retention": {"$ref": "#/$defs/hangul_retention"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "interpretation", "evidence_ids"],
      "properties": {
        "relation_id": {"type": "string"},
        "interpretation": {"type": "string"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "source_element_ids": {"type": "array", "items": {"type": "string"}},
        "relation_type": {"enum": ["next", "depends_on", "contains", "before", "after", "causes", "mitigates", "compares_to", "part_of", "flows_to", "highlights", "other"]},
        "direction": {"enum": ["left_to_right", "right_to_left", "top_to_bottom", "bottom_to_top", "bidirectional", "none", "unknown"]},
        "hangul_retention": {"$ref": "#/$defs/hangul_retention"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "kind", "text", "evidence_ids", "uncertainty"],
      "properties": {
        "claim_id": {"type": "string"},
        "kind": {"enum": ["takeaway", "decision_status", "decision_or_ask", "timing", "key_number", "risk", "dependency", "owner", "trend", "next_step", "other"]},
        "text": {"type": "string"},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "uncertainty": {"enum": ["low", "medium", "high"]},
        "hangul_retention": {"$ref": "#/$defs/hangul_retention"}
      }
    },
    "hangul_retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "evidence_id"],
      "properties": {"reason": {"type": "string"}, "evidence_id": {"type": "string"}}
    }
  }
}
