{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k-slide.invalid/schemas/security-release-evidence.schema.json",
  "title": "K-Slide KSA-33 security release evidence payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "contract_identity_sha256", "policy_id", "policy_version", "policy_identity_sha256",
    "candidate_subject_sha", "candidate_tree_sha256", "deployment_fingerprint", "candidate_spec_identity_sha256",
    "security_run_id", "security_run_attempt", "security_captured_at", "runner_image", "runner_image_version",
    "runner_python_version", "runtime_artifact_identity_sha256", "runtime_manifest_sha256", "runtime_sbom_sha256",
    "runtime_dependency_lock_sha256", "runtime_image_digest", "runtime_source_tree_sha256", "runtime_base_image", "runtime_platform", "container_package_counts",
    "egress_policy_version", "egress_policy_hash", "egress_policy_identity", "egress_default_action",
    "scanner_results", "required_control_results", "vulnerability_finding_count", "vulnerability_disposition_count",
    "vulnerability_dispositions", "unresolved_vulnerability_count", "dependency_audit_pass", "secret_scan_pass",
    "static_scan_pass", "container_scan_pass", "repository_security_pass", "source_document_content_persisted",
    "raw_scanner_payloads_persisted", "access_key_values_persisted", "company_iam_status",
    "company_network_egress_status", "company_deployed_runtime_status"
  ],
  "properties": {
    "contract_version": {"const": "1.0"},
    "contract_identity_sha256": {"$ref": "#/$defs/sha256"},
    "policy_id": {"const": "kimhw8084-k-slide-security-release"},
    "policy_version": {"const": "1.0"},
    "policy_identity_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_subject_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_tree_sha256": {"$ref": "#/$defs/sha256"},
    "deployment_fingerprint": {"$ref": "#/$defs/sha256"},
    "candidate_spec_identity_sha256": {"$ref": "#/$defs/sha256"},
    "security_run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "security_run_attempt": {"type": "integer", "minimum": 1},
    "security_captured_at": {"type": "string", "format": "date-time"},
    "runner_image": {"const": "ubuntu-24.04"},
    "runner_image_version": {"type": "string", "minLength": 1},
    "runner_python_version": {"type": "string", "pattern": "^3\\.11\\.[0-9]+$"},
    "runtime_artifact_identity_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_sbom_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runtime_source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_base_image": {"const": "docker.io/library/python:3.11-slim@sha256:d1053354624536b044162aaab1e418bd000ea35184fb1ae098ab3166b1072e72"},
    "runtime_platform": {"const": "linux/amd64"},
    "container_package_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["lang-pkgs", "os-pkgs"],
      "properties": {"lang-pkgs": {"type": "integer", "minimum": 1}, "os-pkgs": {"type": "integer", "minimum": 1}}
    },
    "egress_policy_version": {"type": "string", "minLength": 1},
    "egress_policy_hash": {"$ref": "#/$defs/sha256"},
    "egress_policy_identity": {"$ref": "#/$defs/sha256"},
    "egress_default_action": {"const": "deny"},
    "scanner_results": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/scanner"}},
    "required_control_results": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/control"}},
    "vulnerability_finding_count": {"type": "integer", "minimum": 0},
    "vulnerability_disposition_count": {"type": "integer", "minimum": 0},
    "vulnerability_dispositions": {"type": "array", "items": {"$ref": "#/$defs/disposition"}},
    "unresolved_vulnerability_count": {"const": 0},
    "dependency_audit_pass": {"const": true},
    "secret_scan_pass": {"const": true},
    "static_scan_pass": {"const": true},
    "container_scan_pass": {"const": true},
    "repository_security_pass": {"const": true},
    "source_document_content_persisted": {"const": false},
    "raw_scanner_payloads_persisted": {"const": false},
    "access_key_values_persisted": {"const": false},
    "company_iam_status": {"const": "UNQUALIFIED"},
    "company_network_egress_status": {"const": "UNQUALIFIED"},
    "company_deployed_runtime_status": {"const": "UNQUALIFIED"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scanner": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "status", "exit_code", "report_sha256", "finished_at", "run_id", "run_attempt", "finding_count", "error_count", "subject_identity"],
      "properties": {
        "id": {"enum": ["pip_audit", "gitleaks", "semgrep", "trivy"]},
        "version": {"type": "string", "minLength": 1},
        "status": {"const": "PASS"},
        "exit_code": {"type": "integer", "minimum": 0},
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "finished_at": {"type": "string", "format": "date-time"},
        "run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "run_attempt": {"type": "integer", "minimum": 1},
        "finding_count": {"type": "integer", "minimum": 0},
        "error_count": {"type": "integer", "minimum": 0},
        "subject_identity": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|sha256:[0-9a-f]{64})$"}
      }
    },
    "control": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "tests_run", "tests_skipped", "source_sha256", "run_id", "run_attempt"],
      "properties": {
        "id": {"enum": ["KSA-15", "KSA-17", "KSA-18", "KSA-21", "KSA-32"]},
        "status": {"const": "PASS"},
        "tests_run": {"type": "integer", "minimum": 1},
        "tests_skipped": {"type": "integer", "minimum": 0},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "run_attempt": {"type": "integer", "minimum": 1}
      }
    },
    "disposition": {
      "type": "object", "additionalProperties": false,
      "required": ["scanner", "package", "version", "vulnerability_id", "severity", "finding_identity_sha256", "disposition", "reason_code", "evidence_sha256", "expires_at", "approval_owner", "candidate_subject_sha", "candidate_tree_sha256", "deployment_fingerprint"],
      "properties": {
        "scanner": {"enum": ["pip_audit", "trivy"]},
        "package": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "vulnerability_id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
        "finding_identity_sha256": {"$ref": "#/$defs/sha256"},
        "disposition": {"enum": ["accepted_risk", "not_affected"]},
        "reason_code": {"enum": ["upstream_disputed", "unreachable_vulnerable_code", "platform_not_affected", "temporary_low_severity_exception"]},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "expires_at": {"type": "string", "format": "date-time"},
        "approval_owner": {"const": "kimhw8084"},
        "candidate_subject_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "candidate_tree_sha256": {"$ref": "#/$defs/sha256"},
        "deployment_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
