{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimhw8084/agent-skills/blob/main/k-slide/schemas/slide-ir.schema.json",
  "title": "K-Slide SlideIR",
  "type": "object",
  "required": ["schema_version", "slide_id", "regions", "tables", "visual_relations", "numeric_facts", "coverage"],
  "$defs": {
    "provenance": {"enum": ["source_fact", "supported_interpretation", "unresolved"]}
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "slide_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "source": {"type": "object"},
    "regions": {"type": "array", "items": {"type": "object", "required": ["region_id"], "properties": {"provenance": {"$ref": "#/$defs/provenance"}, "source_language": {"enum": ["ko", "en", "mixed", "unknown", null]}, "source_english_spans": {"type": "array", "items": {"type": "string"}}, "provenance_evidence_ids": {"type": "array", "items": {"type": "string"}}}}},
    "tables": {"type": "array", "items": {"type": "object", "required": ["table_id", "row_count", "column_count", "cells"], "properties": {"headers": {"type": "array", "items": {"type": "string"}}, "header_rows": {"type": "array", "items": {"type": "integer"}}, "header_columns": {"type": "array", "items": {"type": "integer"}}, "unit": {"type": ["string", "null"]}, "source_notes": {"type": "array", "items": {"type": "string"}}, "cells": {"type": "array", "items": {"type": "object", "required": ["cell_id", "row", "column"], "properties": {"cell_id": {"type": "string", "minLength": 1}, "row": {"type": "integer", "minimum": 0}, "column": {"type": "integer", "minimum": 0}, "rowspan": {"type": "integer", "minimum": 1}, "colspan": {"type": "integer", "minimum": 1}, "source_language": {"enum": ["ko", "en", "mixed", "unknown", null]}, "source_english_spans": {"type": "array", "items": {"type": "string"}}, "cell_state": {"type": "string"}, "is_merge_origin": {"type": ["boolean", "null"]}, "is_spanned": {"type": ["boolean", "null"]}, "is_blank": {"type": ["boolean", "null"]}, "is_header": {"type": ["boolean", "null"]}, "provenance": {"$ref": "#/$defs/provenance"}, "provenance_evidence_ids": {"type": "array", "items": {"type": "string"}}}}}}}},
    "visual_elements": {"type": "array"},
    "visual_relations": {"type": "array", "items": {"type": "object", "properties": {"provenance": {"$ref": "#/$defs/provenance"}, "evidence": {"type": "array", "items": {"type": "string"}}, "unresolved_reason": {"type": "string"}, "chart_claim": {"type": "object"}}}},
    "numeric_facts": {"type": "array"},
    "entities": {"type": "array"},
    "terms": {"type": "array"},
    "unresolved": {"type": "array"},
    "coverage": {"type": "array", "items": {"type": "object", "required": ["source_id", "status"]}},
    "executive_semantics": {"type": "object", "properties": {"executive_claims": {"type": "array", "items": {"type": "object", "properties": {"provenance": {"$ref": "#/$defs/provenance"}, "evidence_ids": {"type": "array", "items": {"type": "string"}}, "unresolved_reason": {"type": "string"}}}}}}
  },
  "additionalProperties": true
}
