{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k-slide.invalid/schemas/ksa38-qualification-v1.schema.json",
  "title": "K-Slide KSA-38 Qualification Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "operation",
    "request",
    "exact_base_sha",
    "product_subject_sha",
    "change_base_sha",
    "execution_base_sha",
    "work_branch",
    "predecessor_lineage",
    "historical_lineage",
    "integration_lineage",
    "candidate_binding",
    "coverage_sha256",
    "artifact_hashes",
    "closure_snapshot_authority",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project": {
      "const": "k-slide"
    },
    "operation": {
      "const": "FIX"
    },
    "request": {
      "const": "chg16-requirement-traceability-01-fix04"
    },
    "product_subject_sha": {
      "const": "23669bacb0392aecc009ae19c7b8c645f1d8c7dd"
    },
    "change_base_sha": {
      "const": "af5836540304b424289bedbe57a87dbb5d02763f"
    },
    "execution_base_sha": {
      "const": "8fc9d6c9f87e9dec0c0a75075e7137bb9698f86d"
    },
    "checks": {
      "type": "array",
      "minItems": 14,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "work_branch": {
      "const": "codex/k-slide-chg16-requirement-traceability-01-fix04"
    },
    "exact_base_sha": {
      "const": "23669bacb0392aecc009ae19c7b8c645f1d8c7dd"
    },
    "predecessor_lineage": {
      "$ref": "#/$defs/predecessorLineage"
    },
    "historical_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lineageRecord"
      }
    },
    "integration_lineage": {
      "$ref": "#/$defs/integrationLineage"
    },
    "candidate_binding": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/candidateBinding"
        }
      ]
    },
    "coverage_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "artifact_hashes": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/artifactHashes"
        }
      ]
    },
    "closure_snapshot_authority": {
      "const": "PROJECT_OS_BOUND_DISPATCH_SNAPSHOT"
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "command",
        "python_version",
        "status",
        "tests_passed",
        "tests_skipped",
        "warnings",
        "details"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "python_version": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^3\\.(11|12)\\.[0-9]+$"
            }
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "NOT_REQUIRED"
          ]
        },
        "tests_passed": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "tests_skipped": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "warnings": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "details": {
          "type": "string"
        }
      }
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "tree_oid",
        "parent_sha",
        "work_branch",
        "worktree_clean_at_product_candidate"
      ],
      "properties": {
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree_oid": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "parent_sha": {
          "const": "8fc9d6c9f87e9dec0c0a75075e7137bb9698f86d"
        },
        "work_branch": {
          "const": "codex/k-slide-chg16-requirement-traceability-01-fix04"
        },
        "worktree_clean_at_product_candidate": {
          "const": true
        }
      }
    },
    "predecessorLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "disposition",
        "work_head",
        "traceability_product_commit",
        "native_evidence_commit",
        "native_build_job_id"
      ],
      "properties": {
        "request": {
          "const": "chg16-requirement-traceability-01-fix03"
        },
        "disposition": {
          "const": "ACCEPTED"
        },
        "work_head": {
          "const": "5d48a1ad189e108e2f9fda5fb4fe59805ca944a2"
        },
        "traceability_product_commit": {
          "const": "e5903b405f116a04f11c1402c75a7bc9d22f32df"
        },
        "native_evidence_commit": {
          "const": "defcf1eda11038fad75f825b678f50795eff485c"
        },
        "native_build_job_id": {
          "const": "CF-5138c2009554585799d1357c"
        }
      }
    },
    "lineageRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "disposition",
        "work_head",
        "traceability_product_commit",
        "native_evidence_commit",
        "native_build_job_id"
      ],
      "properties": {
        "request": {
          "type": "string",
          "pattern": "^chg16-requirement-traceability-01(?:-fix[0-9]{2})?$"
        },
        "disposition": {
          "enum": [
            "ACCEPTED",
            "REJECTED",
            "BUILD_PREDECESSOR"
          ]
        },
        "work_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "traceability_product_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "native_evidence_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "native_build_job_id": {
          "type": "string",
          "pattern": "^CF-[0-9a-f]{16,32}$"
        }
      }
    },
    "artifactHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_context",
        "matrix",
        "matrix_schema",
        "candidate_evidence_schema",
        "qualification_schema",
        "scope_registry",
        "human_report"
      ],
      "properties": {
        "candidate_context": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "matrix": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "matrix_schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_evidence_schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "qualification_schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scope_registry": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "human_report": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "integrationLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pull_request_number",
        "merge_commit_sha",
        "accepted_head_sha",
        "native_evidence_commit",
        "native_build_job_id"
      ],
      "properties": {
        "pull_request_number": {
          "const": 40
        },
        "merge_commit_sha": {
          "const": "8fc9d6c9f87e9dec0c0a75075e7137bb9698f86d"
        },
        "accepted_head_sha": {
          "const": "5d48a1ad189e108e2f9fda5fb4fe59805ca944a2"
        },
        "native_evidence_commit": {
          "const": "defcf1eda11038fad75f825b678f50795eff485c"
        },
        "native_build_job_id": {
          "const": "CF-5138c2009554585799d1357c"
        }
      }
    }
  }
}
